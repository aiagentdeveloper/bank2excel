# Copy to .env and fill in real values. NEVER commit .env

# Required - generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-random-64-hex-char-string

# Gumroad (https://app.gumroad.com/settings/advanced -> API -> token)
# Product must be of type "License Key". Product ID is the product permalink.
GUMROAD_ACCESS_TOKEN=
GUMROAD_PRODUCT_ID=
# Your Gumroad product checkout URL, e.g. https://yourname.gumroad.com/l/bank2excel
GUMROAD_CHECKOUT_URL=

# Optional
PORT=3000
NODE_ENV=development
MAX_UPLOAD_BYTES=10485760
TEMP_TTL_MS=900000
TRUST_PROXY=false